{
  "name": "meditrack-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/migrate.ts --seed",
    "env:init": "node scripts/init-env.mjs",
    "test:prepare": "node --env-file-if-exists=.env scripts/prepare-tests.mjs",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "redis": "^5.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
